g_end,\\n            dimension,\\n            dimension_value,\\n            \\n    case\\n        when dimension is not null and column_name is null\\n        then 'The last ' || metric_name || ' value for dimension ' || dimension || ' - ' || case when dimension_value is null then 'NULL' else dimension_value end || ' is ' || cast(round(cast(metric_value as numeric(28,6)), 3) as varchar) || '. The average for this metric is ' || cast(round(cast(training_avg as numeric(28,6)), 3) as varchar) || '.'\\n\\n        when dimension is not null and column_name is not null\\n        then 'In column ' || column_name || ', the last ' || metric_name || ' value for dimension ' || dimension || ' is ' || cast(round(cast(metric_value as numeric(28,6)), 3) as varchar) || '. The average for this metric is ' || cast(round(cast(training_avg as numeric(28,6)), 3) as varchar) || '.'\\n\\n        when metric_name = 'freshness'\\n        then 'Last update was at ' || anomalous_value || ', which is' || cast(abs(round(cast(metric_value/3600 as numeric(28,6)), 2)) as varchar) || ' hours without updates (only full buckets are considered). Usually the table is updated within ' || cast(abs(round(cast(training_avg/3600 as numeric(28,6)), 2)) as varchar) || ' hours.'\\n\\n        when column_name is null\\n        then 'The last ' || metric_name || ' value is ' || cast(round(cast(metric_value as numeric(28,6)), 3) as varchar) || '. The average for this metric is ' || cast(round(cast(training_avg as numeric(28,6)), 3) as varchar) || '.'\\n\\n        when column_name is not null\\n        then 'In column ' || column_name || ', the last ' || metric_name || ' value is ' || cast(round(cast(metric_value as numeric(28,6)), 3) as varchar) || '. The average for this metric is ' || cast(round(cast(training_avg as numeric(28,6)), 3) as varchar) || '.'\\n\\n        else null\\n    end as anomaly_description\\n,\\n            max(bucket_end) over (partition by test_execution_id) as max_bucket_end\\n        fro