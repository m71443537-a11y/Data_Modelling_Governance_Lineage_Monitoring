PRACTICE_DB", "identifier": "MODEL_RUN_RESULTS", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "MONITORS_RUNS", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "MY_FIRST_DBT_MODEL", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "ORDERS", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "SCHEMA_COLUMNS_SNAPSHOT", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "SEED_RUN_RESULTS", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "SNAPSHOT_RUN_RESULTS", "schema": "RAW"}, {"database": "PRACTICE_DB", "identifier": "TEST_RESULT_ROWS", "schema": "RAW"}], "schema": "RAW"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "455ad714-cf14-4f4d-9060-c715f4a89227", "level": "debug", "msg": "While listing relations in database=PRACTICE_DB, schema=RAW, found: ALERTS_ANOMALY_DETECTION, ALERTS_DBT_MODELS, ALERTS_DBT_SOURCE_FRESHNESS, ALERTS_DBT_TESTS, ALERTS_SCHEMA_CHANGES, ANOMALY_THRESHOLD_SENSITIVITY, DATA_MONITORING_METRICS, DBT_ARTIFACTS_HASHES, DBT_COLUMNS, DBT_EXPOSURES, DBT_GROUPS, DBT_INVOCATIONS, DBT_METRICS, DBT_MODELS, DBT_RUN_RESULTS, DBT_SEEDS, DBT_SNAPSHOTS, DBT_SOURCES, DBT_SOURCE_FRESHNESS_RESULTS, DBT_TESTS, ELEMENTARY_TEST_RESULTS, JOB_RUN_RESULTS, METADATA, METRICS_ANOMALY_SCORE, MODEL_RUN_RESULTS, MONITORS_RUNS, MY_FIRST_DBT_MODEL, ORDERS, SCHEMA_COLUMNS_SNAPSHOT, SEED_RUN_RESULTS, SNAPSHOT_RUN_RESULTS, TEST_RESULT_ROWS", "name": "ListRelations", "pid": 7807, "thread": "MainThread", "ts": "2026-04-09T16:25:51.482701Z"}}
