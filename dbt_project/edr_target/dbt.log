e_name,\n                  schema_name,\n                  depends_on_macros,\n                  depends_on_nodes,\n                  original_path as full_path,\n                  path,\n                  patch_path,\n                  generated_at,\n                  unique_key,\n                  incremental_strategy\n                from PRACTICE_DB.RAW.dbt_snapshots\n              )\n            select * from dbt_artifacts_snapshots\n/* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"0041dd04-9cb0-4404-8be7-bdb0128fd3d7\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.7\", \"profile_name\": \"elementary\", \"target_name\": \"elementary\", \"connection_name\": \"macro_log_macro_results\"} */", "name": "SQLQuery", "pid": 7807, "thread": "MainThread", "ts": "2026-04-09T16:27:04.350354Z"}}
